generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Occupation {
  SALARIED_PRIVATE
  SALARIED_GOVERNMENT_PSU
  SELF_EMPLOYED_PROFESSIONAL
  SELF_EMPLOYED_BUSINESS
  UNEMPLOYED
  STUDENT
  RETIRED_PENSIONER
  NRI
}

enum CardTier {
  BASIC
  STANDARD
  PREMIUM
  SUPER_PREMIUM
  ULTRA_PREMIUM
}

enum CardType {
  CASHBACK
  REWARDS
  TRAVEL
  FUEL
  LIFESTYLE
  SHOPPING
  DINING
  PREMIUM
  SUPER_PREMIUM
  BUSINESS
  STUDENT
  SECURED
  CO_BRANDED
  FOREX
  OTHER
}

enum Bank {
  HDFC_BANK
  ICICI_BANK
  SBI_CARD
  AXIS_BANK
  KOTAK_MAHINDRA_BANK
  INDUSIND_BANK
  IDFC_FIRST_BANK
  YES_BANK
  AU_SMALL_FINANCE_BANK
  RBL_BANK
  HSBC
  STANDARD_CHARTERED
  AMERICAN_EXPRESS
  FEDERAL_BANK
  ONECARD
  OTHER
}

model User {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  firstName        String            @db.VarChar(100)
  lastName         String            @db.VarChar(100)
  email            String            @unique @db.VarChar(255)
  password         String            @db.VarChar(255)
  phoneNumber      String?           @db.VarChar(32)
  role             Role              @default(USER)
  createdAt        DateTime          @default(now()) @db.Timestamp(0)
  updatedAt        DateTime          @updatedAt @db.Timestamp(0)

  financialProfile FinancialProfile?

  @@map("users")
}

model FinancialProfile {
  id                     BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userId                 BigInt            @unique @db.UnsignedBigInt

  // Basic information
  age                    Int?
  income                 Decimal?          @db.Decimal(12, 2)
  occupation             Occupation?
  employmentTenureMonths Int?

  // Credit profile
  hasCreditHistory       Boolean?
  creditScore            Int?
  creditHistoryMonths    Int?

  // Existing debt
  existingLoans          Int?
  existingCreditCards    Int?
  totalMonthlyEMI        Decimal?          @db.Decimal(12, 2)

  // Repayment behavior
  latePayments           Int?
  defaults               Int?

  // Bank relationship
  hasBankRelationship    Boolean?

  createdAt              DateTime          @default(now()) @db.Timestamp(0)
  updatedAt              DateTime          @updatedAt @db.Timestamp(0)

    user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_profiles")
}

model CreditCard {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt

  bank                  String   @db.VarChar(100)
  cardName              Bank?
  cardType              CardType?

  annualFee             Decimal? @db.Decimal(10, 2)
  joiningFee            Decimal? @db.Decimal(10, 2)

  rewards               String?  @db.Text
  cashback              String?  @db.Text
  loungeAccess          String?  @db.Text
  forexCharges          Decimal? @db.Decimal(5, 2)

  minimumIncome         Decimal? @db.Decimal(12, 2)
  minimumCreditScore    Int?

  eligibilityScore      Int?
  cardTier              CardTier?

  benefits              Json?

  brochureUrl           String?  @db.VarChar(500)
  sourceUrl             String?  @db.VarChar(500)

  createdAt             DateTime @default(now()) @db.Timestamp(0)
  updatedAt             DateTime @updatedAt @db.Timestamp(0)

  @@unique([bank, cardName])

  @@map("credit_cards")
}